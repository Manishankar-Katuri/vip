NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-high-entropy-staging-secret
WEB_APP_URL=https://staging.vip.example
NEXT_PUBLIC_APP_URL=https://staging.vip.example
OPENAI_API_KEY=sk-proj-staging-placeholder
OPENAI_QUOTA_APPROVED=true
AI_AUDIT_INGEST_KEY=replace-with-staging-secret
GOOGLE_CLIENT_ID=replace-if-google-auth-enabled
GOOGLE_CLIENT_SECRET=replace-if-google-auth-enabled
GOOGLE_REDIRECT_URI=https://staging-api.vip.example/auth/google/callback
GOOGLE_PLACES_KEY=replace-if-enabled
GOOGLE_OAUTH_ACCESS_TOKEN=replace-if-gbp-enabled

