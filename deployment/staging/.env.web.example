NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://staging.vip.example
NEXT_PUBLIC_API_BASE_URL=https://staging-api.vip.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
OPENAI_API_KEY=sk-proj-staging-placeholder
OPENAI_MODEL=gpt-4.1-mini
AI_AUDIT_INGEST_KEY=replace-with-staging-secret
GOOGLE_MAPS_API_KEY=replace-if-enabled
GOOGLE_PLACES_KEY=replace-if-enabled
FACEBOOK_ACCESS_TOKEN=replace-if-social-ingest-enabled
INSTAGRAM_BUSINESS_ID=replace-if-social-ingest-enabled
INSTAGRAM_ACCESS_TOKEN=replace-if-social-ingest-enabled
HOSPITAL_CONFIG_ENCRYPTION_KEY=replace-with-32-byte-base64-key

