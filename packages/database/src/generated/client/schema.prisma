generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BrandMemory {
  id              String   @id @default(uuid())
  workspaceId     String
  hospitalName    String?
  specialty       String?
  tone            String?
  audience        String?
  doctors         Json?
  platforms       Json?
  topics          Json?
  hashtags        Json?
  contentPatterns Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContentDraft {
  id                String            @id @default(uuid())
  workspaceId       String
  title             String
  content           String
  platform          ContentPlatform
  status            ContentStatus     @default(DRAFT)
  createdAt         DateTime          @default(now())
  HospitalWorkspace HospitalWorkspace @relation(fields: [workspaceId], references: [id])
}

model ContentCalendarItem {
  id                   String                  @id @default(uuid())
  hospitalId           String
  clientId             String?
  platform             String?
  plannedTopic         String?
  plannedCaption       String?
  plannedAssets        Json                    @default("[]")
  plannedPostingTime   String?
  campaignTheme        String?
  goal                 String?
  approvalStatus       String                  @default("PENDING")
  title                String
  description          String                  @default("")
  contentType          ContentCalendarType
  category             ContentCalendarCategory
  status               ContentCalendarStatus   @default(IDEA)
  priority             ContentCalendarPriority @default(MEDIUM)
  scheduledDate        DateTime
  publishedDate        DateTime?
  campaignId           String?
  createdBy            String
  assignedTo           String?
  tags                 String[]
  isSpecialDay         Boolean                 @default(false)
  specialDayName       String?
  position             Int                     @default(0)
  deletedAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  hospital             HospitalWorkspace       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  creator              User                    @relation("ContentCalendarCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  assignee             User?                   @relation("ContentCalendarAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  scripts              ContentCalendarScript[]
  contentPlanDecisions ContentPlanDecision[]

  @@index([hospitalId, scheduledDate])
  @@index([hospitalId, status, scheduledDate])
  @@index([hospitalId, contentType])
  @@index([hospitalId, category])
  @@index([hospitalId, assignedTo])
  @@index([campaignId])
  @@index([deletedAt])
}

model ContentPlanDecision {
  id                      String                  @id @default(uuid())
  workspaceId             String
  clientId                String?
  calendarItemId          String?
  executionWindowId       String
  decision                ContentPlanDecisionType
  originalTopic           String?
  finalTopic              String
  originalContentType     String?
  finalContentType        String
  decisionReason          String
  intelligenceSignalsUsed Json                    @default("{}")
  confidenceScore         Float
  createdAt               DateTime                @default(now())
  workspace               HospitalWorkspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  calendarItem            ContentCalendarItem?    @relation(fields: [calendarItemId], references: [id], onDelete: SetNull)
  executionWindow         ContentExecutionWindow  @relation(fields: [executionWindowId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([calendarItemId])
  @@index([executionWindowId])
  @@map("content_plan_decisions")
}

model ContentExecutionWindow {
  id              String                     @id @default(uuid())
  workspaceId     String
  windowType      String
  sendDay         String
  sendTime        String
  windowStartDate DateTime
  windowEndDate   DateTime
  purpose         String
  status          String                     @default("GENERATED")
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  workspace       HospitalWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decisions       ContentPlanDecision[]
  documents       ContentExecutionDocument[]

  @@index([workspaceId, windowStartDate, windowEndDate])
  @@index([workspaceId, sendDay, createdAt])
  @@map("content_execution_windows")
}

model ContentExecutionDocument {
  id                String                 @id @default(uuid())
  workspaceId       String
  executionWindowId String
  documentType      String
  title             String
  contentJson       Json
  fileUrl           String?
  emailSubject      String
  emailBody         String
  deliveryStatus    String                 @default("DRAFT")
  generatedAt       DateTime               @default(now())
  sentAt            DateTime?
  createdAt         DateTime               @default(now())
  workspace         HospitalWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionWindow   ContentExecutionWindow @relation(fields: [executionWindowId], references: [id], onDelete: Cascade)
  deliveryLogs      ContentDeliveryLog[]

  @@index([workspaceId, generatedAt])
  @@index([executionWindowId])
  @@index([deliveryStatus])
  @@map("content_execution_documents")
}

model ContentDeliveryLog {
  id                  String                   @id @default(uuid())
  workspaceId         String
  executionDocumentId String
  recipientEmail      String
  deliveryStatus      String
  providerMessageId   String?
  errorMessage        String?
  sentAt              DateTime                 @default(now())
  createdAt           DateTime                 @default(now())
  workspace           HospitalWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionDocument   ContentExecutionDocument @relation(fields: [executionDocumentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([executionDocumentId])
  @@index([deliveryStatus])
  @@map("content_delivery_logs")
}

model ContentCalendarScript {
  id             String              @id @default(uuid())
  calendarItemId String
  hospitalId     String
  title          String
  scriptType     ContentScriptType
  status         ContentScriptStatus @default(DRAFT)
  hook           String              @default("")
  script         String              @default("")
  caption        String              @default("")
  cta            String              @default("")
  hashtags       String[]
  metadata       Json                @default("{}")
  version        Int                 @default(1)
  createdBy      String
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  calendarItem   ContentCalendarItem @relation(fields: [calendarItemId], references: [id], onDelete: Cascade)
  hospital       HospitalWorkspace   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  creator        User                @relation("ContentCalendarScriptCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approver       User?               @relation("ContentCalendarScriptApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([calendarItemId, version])
  @@index([hospitalId, createdAt])
  @@index([hospitalId, status])
  @@index([calendarItemId, version])
}

model ContentGeneratorRun {
  id                 String            @id @default(uuid())
  hospitalId         String
  createdBy          String
  idea               String
  platform           String
  format             String
  audience           String            @default("")
  objective          String            @default("")
  doctorName         String?
  serviceLine        String?
  languagePlan       String            @default("")
  urgency            String            @default("normal")
  requestType        String            @default("outside_strategy")
  desiredPublishDate DateTime?
  strategyFit        String            @default("Adjacent")
  contentPillar      String            @default("education")
  generatedContext   Json              @default("{}")
  evidence           Json              @default("[]")
  safetyNotes        Json              @default("[]")
  output             Json              @default("{}")
  status             String            @default("DRAFT")
  rejectionReason    String?
  calendarItemId     String?
  scriptId           String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  hospital           HospitalWorkspace @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId, createdAt])
  @@index([hospitalId, status])
  @@index([hospitalId, strategyFit])
  @@index([calendarItemId])
  @@index([scriptId])
}

model HospitalRequest {
  id                String             @id @default(uuid())
  hospitalName      String
  contactName       String
  email             String
  website           String?
  status            RequestStatus      @default(NEW)
  createdAt         DateTime           @default(now())
  HospitalWorkspace HospitalWorkspace?
}

model HospitalWorkspace {
  id                        String                      @id @default(uuid())
  hospitalRequestId         String?                     @unique
  name                      String
  hospitalName              String
  slug                      String                      @unique
  hospitalCode              String?                     @unique
  domain                    String?
  industryType              String?
  contactEmail              String?
  specialty                 String?
  city                      String?
  status                    WorkspaceStatus             @default(CREATING)
  lastSyncAt                DateTime?
  disabledAt                DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  ContentDraft              ContentDraft[]
  HospitalRequest           HospitalRequest?            @relation(fields: [hospitalRequestId], references: [id])
  KnowledgeSource           KnowledgeSource[]
  VectorMemory              VectorMemory[]
  WebsiteContent            WebsiteContent[]
  users                     User[]
  invitations               Invitation[]
  auditLogs                 AuditLog[]
  brandVoice                BrandVoice?
  templates                 Template[]
  contentCalendarItems      ContentCalendarItem[]
  contentCalendarScripts    ContentCalendarScript[]
  contentGeneratorRuns      ContentGeneratorRun[]
  contentPlanDecisions      ContentPlanDecision[]
  contentExecutionWindows   ContentExecutionWindow[]
  contentExecutionDocuments ContentExecutionDocument[]
  contentDeliveryLogs       ContentDeliveryLog[]
  integrationConfigs        HospitalIntegrationConfig[]
}

model HospitalIntegrationConfig {
  id                   String                  @id @default(uuid())
  hospitalId           String
  provider             String
  apiName              String
  baseUrl              String?
  encryptedCredentials String
  credentialMeta       Json                    @default("{}")
  settings             Json                    @default("{}")
  status               IntegrationConfigStatus @default(PENDING)
  lastValidatedAt      DateTime?
  lastTestedAt         DateTime?
  lastSyncAt           DateTime?
  lastError            String?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  hospital             HospitalWorkspace       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, provider, apiName])
  @@index([hospitalId])
  @@index([provider])
  @@index([status, updatedAt])
  @@index([updatedAt])
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  name                    String?
  role                    UserRole                @default(STAFF)
  hospitalId              String?
  isGlobal                Boolean                 @default(false)
  isActive                Boolean                 @default(true)
  passwordHash            String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  hospital                HospitalWorkspace?      @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  auditLogs               AuditLog[]
  createdCalendarItems    ContentCalendarItem[]   @relation("ContentCalendarCreatedBy")
  assignedCalendarItems   ContentCalendarItem[]   @relation("ContentCalendarAssignedTo")
  createdCalendarScripts  ContentCalendarScript[] @relation("ContentCalendarScriptCreatedBy")
  approvedCalendarScripts ContentCalendarScript[] @relation("ContentCalendarScriptApprovedBy")

  @@index([role])
  @@index([hospitalId])
  @@index([isGlobal])
  @@index([isActive])
}

model Invitation {
  id         String             @id @default(uuid())
  email      String
  role       UserRole
  hospitalId String?
  isGlobal   Boolean
  token      String             @unique
  status     InvitationStatus   @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime           @default(now())
  acceptedAt DateTime?
  hospital   HospitalWorkspace? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status, expiresAt])
  @@index([hospitalId])
}

model AuditLog {
  id         String             @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  hospitalId String?
  createdAt  DateTime           @default(now())
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospital   HospitalWorkspace? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([hospitalId, createdAt])
  @@index([resource, resourceId])
}

model BrandVoice {
  id         String            @id @default(uuid())
  hospitalId String            @unique
  tone       String            @default("")
  style      String            @default("")
  audience   String            @default("")
  messaging  String            @default("")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  hospital   HospitalWorkspace @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

model Template {
  id         String            @id @default(uuid())
  hospitalId String
  title      String
  category   String
  content    String
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  hospital   HospitalWorkspace @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId, category])
  @@index([hospitalId, isActive])
}

model KnowledgeSource {
  id                String            @id @default(uuid())
  workspaceId       String
  sourceType        String
  sourceName        String
  sourceUrl         String?
  createdAt         DateTime          @default(now())
  HospitalWorkspace HospitalWorkspace @relation(fields: [workspaceId], references: [id])
}

model Review {
  id            String   @id @default(uuid())
  workspaceId   String
  author        String?
  rating        Int
  content       String
  source        String
  sentiment     String?
  category      String?
  issueDetected Boolean  @default(false)
  aiReply       String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}

model ReviewAlert {
  id          String   @id @default(uuid())
  workspaceId String
  category    String
  count       Int
  severity    String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

model VectorMemory {
  id                String            @id @default(uuid())
  workspaceId       String
  sourceId          String
  chunkText         String
  embedding         Json
  createdAt         DateTime          @default(now())
  WebsiteContent    WebsiteContent    @relation(fields: [sourceId], references: [id])
  HospitalWorkspace HospitalWorkspace @relation(fields: [workspaceId], references: [id])
}

model WebsiteContent {
  id                String            @id @default(uuid())
  workspaceId       String
  url               String
  title             String?
  description       String?
  content           String
  createdAt         DateTime          @default(now())
  VectorMemory      VectorMemory[]
  HospitalWorkspace HospitalWorkspace @relation(fields: [workspaceId], references: [id])
}

model Workspace {
  id                         String                                @id @default(uuid())
  name                       String
  slug                       String                                @unique
  createdAt                  DateTime                              @default(now())
  updatedAt                  DateTime                              @updatedAt
  aiRecommendations          AIRecommendation[]
  audienceInsights           AudienceInsight[]
  competitorAccounts         CompetitorAccount[]
  contentCategories          ContentCategory[]
  engagementSnapshots        EngagementSnapshot[]
  marketContexts             MarketContextSnapshot[]
  marketSignals              MarketSignalObservation[]
  socialAccounts             SocialAccount[]
  socialPosts                SocialPost[]
  strategySnapshots          StrategySnapshot[]
  recommendationTransitions  RecommendationStatusTransition[]
  recommendationOutcomes     RecommendationOutcome[]
  strategyAuditEvents        StrategyAuditEvent[]
  strategyOutboxEvents       StrategyOutboxEvent[]
  actionPlans                ActionPlan[]
  actionExecutions           ActionExecution[]
  executionSteps             ExecutionStep[]
  executionLogs              ExecutionLog[]
  executionFailures          ExecutionFailure[]
  approvalRequests           ApprovalRequest[]
  actionOutboxEvents         ActionOutboxEvent[]
  automationRules            AutomationRule[]
  automationExecutions       AutomationExecution[]
  automationExecutionLogs    AutomationExecutionLog[]
  automationOutboxEvents     AutomationOutboxEvent[]
  eventEnvelopes             EventEnvelope[]
  eventDeadLetters           EventDeadLetter[]
  aiExecutionTraces          AIExecutionTrace[]
  agentMemoryEntries         AgentMemoryEntry[]
  promptTemplates            PromptTemplate[]
  members                    WorkspaceMember[]
  roles                      Role[]
  apiKeys                    APIKey[]
  usageEvents                UsageEvent[]
  subscription               WorkspaceSubscription?
  controlPlaneAuditEvents    ControlPlaneAuditEvent[]
  operationalErrors          OperationalError[]
  operationalCampaigns       OperationalCampaign[]
  operationalEvents          OperationalActivityEvent[]
  operationalNotifications   OperationalNotification[]
  operationalTasks           OperationalTask[]
  operationalActions         OperationalRecommendationAction[]
  operationalMediaAssets     OperationalMediaAsset[]
  operationalContentVersions OperationalContentVersion[]
  systemEndpointHealth       SystemEndpointHealth[]
  systemVerificationRuns     SystemVerificationRun[]
  systemVerificationChecks   SystemVerificationCheck[]
  dataProvenanceSnapshots    DataProvenanceSnapshot[]
  aiProviderHealth           AiProviderHealth[]
  pdfExportRuns              PdfExportRun[]
  recommendationFingerprints RecommendationSimilarityFingerprint[]
  missionExecutions          MissionExecution[]
  dailyBusinessSnapshots     DailyBusinessSnapshot[]
  dailyPerformanceReports    DailyPerformanceReport[]
  strategyOutcomes           StrategyOutcome[]
  trendOpportunities         TrendOpportunity[]
  contentBriefs              ContentBrief[]
  contentProductionPackages  ContentProductionPackage[]
  dailyGrowthReports         DailyGrowthReport[]
  reportDrafts               ReportDraft[]
  reportExports              ReportExport[]
  reportApprovals            ReportApproval[]
  reportRecipients           ReportRecipient[]
  reportDeliveries           ReportDelivery[]
  clientOperationalSettings  ClientOperationalSettings?
  contentOutcomes            ContentOutcome[]
  agentLearningMemories      AgentLearningMemory[]
  pilotQualityReviews        PilotQualityReview[]
}

model OperationalCampaign {
  id                    String                      @id
  workspaceId           String
  title                 String
  channel               String
  stage                 String
  approval              String
  clinicalRisk          String
  caption               String
  strategyNote          String
  objective             String                      @default("")
  audienceNotes         String                      @default("")
  engagementExpectation String                      @default("")
  hashtags              Json                        @default("[]")
  format                String                      @default("announcement")
  recommendation        String?
  scheduledFor          String?
  performance           String?
  owner                 String
  reviewer              String?
  participants          Json
  updatedLabel          String
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  workspace             Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mediaAssets           OperationalMediaAsset[]
  versions              OperationalContentVersion[]

  @@index([workspaceId, stage, updatedAt])
  @@index([workspaceId, approval, updatedAt])
}

model OperationalMediaAsset {
  id          String               @id
  workspaceId String
  campaignId  String?
  title       String
  fileName    String
  fileType    String
  kind        String
  status      String
  sourceRole  String
  uploadedBy  String
  altText     String
  rightsNote  String
  visibleTo   Json
  uploadedAt  DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign    OperationalCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, uploadedAt])
  @@index([workspaceId, campaignId, uploadedAt])
}

model OperationalContentVersion {
  id                String              @id
  workspaceId       String
  campaignId        String
  version           Int
  caption           String
  strategyNote      String
  changedSummary    String
  modifiedBy        String
  approval          String
  rollbackAvailable Boolean             @default(true)
  createdAt         DateTime            @default(now())
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign          OperationalCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, version])
  @@index([workspaceId, createdAt])
}

model OperationalActivityEvent {
  id             String    @id
  workspaceId    String
  campaignId     String?
  category       String
  title          String
  description    String
  actor          String
  actorRole      String
  tone           String
  visibleTo      Json
  transitionFrom String?
  transitionTo   String?
  occurredAt     DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, campaignId, occurredAt])
}

model OperationalNotification {
  id          String    @id
  workspaceId String
  campaignId  String?
  role        String
  category    String
  groupKey    String
  title       String
  detail      String
  tone        String
  unread      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, role, unread, createdAt])
  @@index([workspaceId, groupKey, createdAt])
}

model OperationalTask {
  id           String    @id
  workspaceId  String
  title        String
  due          String
  status       String
  completed    Boolean   @default(false)
  assigneeRole String    @default("staff")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, assigneeRole, status])
}

model OperationalRecommendationAction {
  id          String    @id @default(uuid())
  workspaceId String
  title       String
  status      String
  actor       String
  actedAt     DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, title])
  @@index([workspaceId, actedAt])
}

model SocialAccount {
  id                String         @id @default(uuid())
  workspaceId       String
  platform          SocialPlatform
  externalAccountId String
  status            String         @default("ACTIVE")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts             SocialPost[]

  @@unique([platform, externalAccountId])
}

model SocialPost {
  id                String               @id @default(uuid())
  workspaceId       String
  socialAccountId   String
  contentCategoryId String?
  platform          SocialPlatform
  postId            String
  url               String?
  caption           String?
  mediaUrl          String?
  mediaType         String?
  contentType       SocialContentType
  postedAt          DateTime
  rawData           Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  snapshots         EngagementSnapshot[]
  hashtags          PostHashtag[]
  metrics           PostMetrics?
  contentCategory   ContentCategory?     @relation(fields: [contentCategoryId], references: [id])
  socialAccount     SocialAccount        @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([platform, postId])
  @@index([workspaceId, postedAt])
  @@index([workspaceId, contentType, postedAt])
  @@index([workspaceId, contentCategoryId, postedAt])
}

model PostMetrics {
  id              String     @id @default(uuid())
  socialPostId    String     @unique
  likes           Int        @default(0)
  comments        Int        @default(0)
  shares          Int        @default(0)
  saves           Int        @default(0)
  clicks          Int        @default(0)
  reach           Int        @default(0)
  impressions     Int        @default(0)
  videoViews      Int        @default(0)
  engagementRate  Float      @default(0)
  viralityScore   Float      @default(0)
  normalizedScore Float      @default(0)
  rawMetrics      Json?
  updatedAt       DateTime   @updatedAt
  socialPost      SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
}

model EngagementSnapshot {
  id             String         @id @default(uuid())
  workspaceId    String
  socialPostId   String
  platform       SocialPlatform
  likes          Int            @default(0)
  comments       Int            @default(0)
  shares         Int            @default(0)
  saves          Int            @default(0)
  reach          Int            @default(0)
  impressions    Int            @default(0)
  engagementRate Float          @default(0)
  capturedAt     DateTime       @default(now())
  socialPost     SocialPost     @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, capturedAt])
  @@index([workspaceId, platform, capturedAt])
}

model Hashtag {
  id    String        @id @default(uuid())
  tag   String        @unique
  posts PostHashtag[]
}

model PostHashtag {
  socialPostId String
  hashtagId    String
  position     Int        @default(0)
  hashtag      Hashtag    @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  socialPost   SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@id([socialPostId, hashtagId])
}

model ContentCategory {
  id          String              @id @default(uuid())
  workspaceId String
  name        String
  type        ContentCategoryType
  description String?
  createdAt   DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts       SocialPost[]

  @@unique([workspaceId, name])
  @@index([workspaceId, type])
}

model AudienceInsight {
  id          String          @id @default(uuid())
  workspaceId String
  platform    SocialPlatform?
  type        String
  label       String
  value       Float
  confidence  Float
  metadata    Json?
  capturedAt  DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, capturedAt])
}

model CompetitorAccount {
  id             String         @id @default(uuid())
  workspaceId    String
  platform       SocialPlatform
  handle         String
  displayName    String?
  profileUrl     String?
  tier           String         @default("DIRECT")
  notes          String?
  metrics        Json?
