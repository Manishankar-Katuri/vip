model StrategyOutboxEvent {
  id                 String              @id @default(uuid())
  workspaceId        String
  recommendationId   String?
  strategySnapshotId String?
  eventType          String
  aggregateType      String
  aggregateId        String
  payload            Json
  status             StrategyEventStatus @default(PENDING)
  occurredAt         DateTime            @default(now())
  publishedAt        DateTime?
  failureReason      String?
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recommendation     AIRecommendation?   @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  strategySnapshot   StrategySnapshot?   @relation(fields: [strategySnapshotId], references: [id], onDelete: Cascade)

  @@index([status, occurredAt])
  @@index([workspaceId, occurredAt])
}

model ActionPlan {
  id                String              @id @default(uuid())
  workspaceId       String
  recommendationId  String?
  name              String
  type              ActionPlanType
  status            ActionPlanStatus    @default(DRAFT)
  input             Json?
  idempotencyKey    String
  requiresApproval  Boolean             @default(false)
  scheduledFor      DateTime?
  cronExpression    String?
  maxAttempts       Int                 @default(3)
  createdByType     StrategyActorType
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recommendation    AIRecommendation?   @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  steps             ExecutionStep[]
  executions        ActionExecution[]
  approvals         ApprovalRequest[]
  outboxEvents      ActionOutboxEvent[]
  aiExecutionTraces AIExecutionTrace[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, scheduledFor])
  @@index([recommendationId])
}

model ActionExecution {
  id             String                @id @default(uuid())
  workspaceId    String
  actionPlanId   String
  idempotencyKey String
  queueJobId     String?
  status         ActionExecutionStatus @default(QUEUED)
  attempt        Int                   @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  deadLetteredAt DateTime?
  nextRetryAt    DateTime?
  output         Json?
  durationMs     Int?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionPlan     ActionPlan            @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  steps          ExecutionStep[]
  logs           ExecutionLog[]
  failures       ExecutionFailure[]
  outboxEvents   ActionOutboxEvent[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@index([actionPlanId, createdAt])
}

model ExecutionStep {
  id                String              @id @default(uuid())
  workspaceId       String
  actionPlanId      String
  actionExecutionId String?
  position          Int
  name              String
  processor         String
  input             Json?
  output            Json?
  status            ExecutionStepStatus @default(PENDING)
  requiresApproval  Boolean             @default(false)
  attempts          Int                 @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionPlan        ActionPlan          @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  actionExecution   ActionExecution?    @relation(fields: [actionExecutionId], references: [id], onDelete: SetNull)
  logs              ExecutionLog[]
  failures          ExecutionFailure[]

  @@unique([actionPlanId, position])
  @@index([workspaceId, status, updatedAt])
}

model ExecutionLog {
  id                String            @id @default(uuid())
  workspaceId       String
  actionExecutionId String
  executionStepId   String?
  level             ExecutionLogLevel
  eventType         String
  message           String
  metadata          Json?
  createdAt         DateTime          @default(now())
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionExecution   ActionExecution   @relation(fields: [actionExecutionId], references: [id], onDelete: Cascade)
  executionStep     ExecutionStep?    @relation(fields: [executionStepId], references: [id], onDelete: SetNull)

  @@index([actionExecutionId, createdAt])
  @@index([workspaceId, createdAt])
}

model ExecutionFailure {
  id                String          @id @default(uuid())
  workspaceId       String
  actionExecutionId String
  executionStepId   String?
  code              String
  message           String
  retryable         Boolean
  attempt           Int
  details           Json?
  occurredAt        DateTime        @default(now())
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionExecution   ActionExecution @relation(fields: [actionExecutionId], references: [id], onDelete: Cascade)
  executionStep     ExecutionStep?  @relation(fields: [executionStepId], references: [id], onDelete: SetNull)

  @@index([actionExecutionId, occurredAt])
  @@index([workspaceId, occurredAt])
}

model ApprovalRequest {
  id              String                @id @default(uuid())
  workspaceId     String
  actionPlanId    String
  status          ApprovalRequestStatus @default(PENDING)
  requestedByType StrategyActorType
  requestedById   String?
  decidedByType   StrategyActorType?
  decidedById     String?
  reason          String
  decisionNote    String?
  requestedAt     DateTime              @default(now())
  decidedAt       DateTime?
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionPlan      ActionPlan            @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, requestedAt])
  @@index([actionPlanId, requestedAt])
}

model ActionOutboxEvent {
  id                String              @id @default(uuid())
  workspaceId       String
  actionPlanId      String?
  actionExecutionId String?
  eventType         String
  aggregateType     String
  aggregateId       String
  payload           Json
  status            StrategyEventStatus @default(PENDING)
  occurredAt        DateTime            @default(now())
  publishedAt       DateTime?
  failureReason     String?
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionPlan        ActionPlan?         @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  actionExecution   ActionExecution?    @relation(fields: [actionExecutionId], references: [id], onDelete: Cascade)

  @@index([status, occurredAt])
  @@index([workspaceId, occurredAt])
}

model AutomationRule {
  id          String                @id
  workspaceId String
  enabled     Boolean               @default(true)
  trigger     String
  definition  Json
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions  AutomationExecution[]

  @@index([workspaceId, enabled, trigger])
}

model AutomationWorkflowMapping {
  id                 String @id
  recommendationType String
  definition         Json

  @@index([recommendationType])
}

model AutomationExecution {
  id                 String                   @id
  workspaceId        String
  ruleId             String
  recommendationId   String
  sourceEventId      String
  idempotencyKey     String
  status             String
  attempt            Int                      @default(0)
  workflow           Json
  retryPolicy        Json
  queuedAt           DateTime
  scheduledFor       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  nextRetryAt        DateTime?
  rolledBackAt       DateTime?
  deadLetteredAt     DateTime?
  queueJobId         String?
  lastFailure        String?
  deadLetterEligible Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule               AutomationRule           @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  logs               AutomationExecutionLog[]
  outboxEvents       AutomationOutboxEvent[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, queuedAt])
  @@index([workspaceId, ruleId, queuedAt])
}

model AutomationExecutionLog {
  id          String              @id @default(uuid())
  executionId String
  workspaceId String
  level       String
  eventType   String
  message     String
  occurredAt  DateTime
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution   AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, occurredAt])
  @@index([workspaceId, occurredAt])
}

model AutomationOutboxEvent {
  id             String              @id
  workspaceId    String
  executionId    String
  idempotencyKey String
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  status         StrategyEventStatus @default(PENDING)
  occurredAt     DateTime
  publishedAt    DateTime?
  failureReason  String?
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution      AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([status, occurredAt])
  @@index([workspaceId, occurredAt])
}

model EventEnvelope {
  id             String            @id
  eventId        String            @unique
  workspaceId    String
  idempotencyKey String
  topic          String
  eventType      String
  eventVersion   Int
  aggregateType  String
  aggregateId    String
  event          Json
  metadata       Json
  priority       String            @default("NORMAL")
  publishedAt    DateTime
  occurredAt     DateTime
  sequence       Int               @unique @default(autoincrement())
  state          String
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries     EventDelivery[]
  deadLetters    EventDeadLetter[]

  @@unique([workspaceId, idempotencyKey])
  @@index([priority, state, publishedAt])
  @@index([workspaceId, aggregateId, sequence])
  @@index([eventType, occurredAt])
  @@index([topic, state, publishedAt])
}

model EventDelivery {
  id           String        @id @default(uuid())
  envelopeId   String
  subscriberId String
  deliveryKey  String        @unique
  attempt      Int
  status       String
  startedAt    DateTime
  completedAt  DateTime
  latencyMs    Int
  error        String?
  envelope     EventEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([subscriberId, status, completedAt])
  @@index([envelopeId, subscriberId])
}

model EventDeadLetter {
  id             String        @id @default(uuid())
  workspaceId    String
  envelopeId     String
  subscriberId   String
  attempts       Int
  failure        String
  deadLetteredAt DateTime
  snapshot       Json
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  envelope       EventEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, deadLetteredAt])
  @@index([subscriberId, deadLetteredAt])
}

model OperationalError {
  id          String     @id
  workspaceId String?
  category    String
  severity    String
  retryable   Boolean
  code        String
  message     String
  stack       String?
  occurredAt  DateTime
  context     Json
  attributes  Json
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([category, retryable, occurredAt])
  @@index([workspaceId, occurredAt])
}

model AIExecutionTrace {
  id               String            @id @default(uuid())
  workspaceId      String
  recommendationId String?
  actionPlanId     String?
  agentType        AIAgentType
  operation        String
  status           AIRunStatus       @default(PENDING)
  triggerType      String?
  triggerId        String?
  model            String?
  input            Json?
  output           Json?
  toolCalls        Json?
  promptKey        String?
  promptVersion    String?
  inputTokens      Int               @default(0)
  outputTokens     Int               @default(0)
  latencyMs        Int?
  error            String?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recommendation   AIRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  actionPlan       ActionPlan?       @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)

  @@index([workspaceId, agentType, startedAt])
  @@index([workspaceId, status, startedAt])
}

model AgentMemoryEntry {
  id          String      @id @default(uuid())
  workspaceId String
  agentType   AIAgentType
  scope       String
  key         String
  content     Json
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, agentType, scope, key])
  @@index([workspaceId, agentType, updatedAt])
}

model PromptTemplate {
  id           String      @id @default(uuid())
  workspaceId  String
  key          String
  version      String
  agentType    AIAgentType
  systemPrompt String
  userTemplate String
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key, version])
  @@index([workspaceId, agentType, active])
}

model WorkspaceMember {
  id          String                @id @default(uuid())
  workspaceId String
  userId      String
  email       String
  displayName String?
  status      WorkspaceMemberStatus @default(ACTIVE)
  invitedAt   DateTime              @default(now())
  joinedAt    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles       WorkspaceMemberRole[]

  @@unique([workspaceId, userId])
  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

model Role {
  id          String                @id @default(uuid())
  workspaceId String
  name        String
  description String?
  system      Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     WorkspaceMemberRole[]

  @@unique([workspaceId, name])
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model WorkspaceMemberRole {
  memberId String
  roleId   String
  member   WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
}

model APIKey {
  id              String       @id @default(uuid())
  workspaceId     String
  name            String
  prefix          String       @unique
  secretHash      String
  encryptedSecret String?
  scopes          Json
  status          APIKeyStatus @default(ACTIVE)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usageEvents     UsageEvent[]

  @@index([workspaceId, status])
}

model UsageEvent {
  id          String    @id @default(uuid())
  workspaceId String
  apiKeyId    String?
  metric      String
  quantity    Int       @default(1)
  source      String
  metadata    Json?
  occurredAt  DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey      APIKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, metric, occurredAt])
}

model SubscriptionPlan {
  id            String                  @id @default(uuid())
  code          String                  @unique
  name          String
  limits        Json
  features      Json
  monthlyPrice  Int?
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  subscriptions WorkspaceSubscription[]
}

model WorkspaceSubscription {
  id          String             @id @default(uuid())
  workspaceId String             @unique
  planId      String
  status      SubscriptionStatus @default(TRIAL)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([status, periodEnd])
}

model ControlPlaneAuditEvent {
  id          String            @id @default(uuid())
  workspaceId String
  action      String
  actorType   StrategyActorType
  actorId     String?
  targetType  String?
  targetId    String?
  payload     Json?
  createdAt   DateTime          @default(now())
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

